local p = game:GetService("Players").LocalPlayer
local h = game:GetService("HttpService")


local placeId = game.PlaceId
local jobId = game.JobId
local joinUrl = string.format("https://www.roblox.com/games/start?placeId=%d&launchData=%s", placeId, jobId)

local payload = h:JSONEncode({
	embeds = {{
		title = "Player Info",
		color = 0x5865F2,
		fields = {
			{ name = "Username", value = p.Name, inline = true },
			{ name = "User ID", value = tostring(p.UserId), inline = true },
			{ name = "Level", value = tostring(p.leaderstats and p.leaderstats:FindFirstChild("Level") and p.leaderstats.Level.Value or "N/A"), inline = true },
			{ name = "Join", value = string.format("[Join Game](%s)", joinUrl), inline = false }
		}
	}}
})

request({
	Url = "https://discord.com/api/webhooks/1530970121978515617/Tsn4zkmjnmOfaUPLdVbouJiirUWmtvDzx_cBUTa8Qk9KD5TEQ8ye2MfTSbjnKzhkWMmN",
	Method = "POST",
	Headers = { ["Content-Type"] = "application/json" },
	Body = payload
})
